<?xml version="1.0"?>
<launch>

    <arg name="robot" value="robotrainer"/>
     <arg name="pkg_config" default="$(find robotrainer_config)"/>
    <arg name="driver_yaml" default="$(arg pkg_config)/hardware/base_driver.yaml"/>
    <arg name="controller_yaml" default="$(arg pkg_config)/software_default/base_controller.yaml"/>

    <arg name="sim" default="false"/>


    <!-- send raw urdf to param server -->
    <param name="robot_description" command="$(find xacro)/xacro --inorder '$(arg pkg_config)/urdf/sr3_robotrainer.urdf.xacro'"/>

    <!-- TODO: Enable when using simulation -->
    <!-- startup simulated world -->
<!--    <include file="$(find cob_gazebo_worlds)/launch/world.launch" if="$(arg sim)">
        <arg name="robot_env" value="ipa-apartment" />
        <arg name="pkg_env_config" value="$(arg pkg_env_config)" />
        <arg name="pkg_gazebo_worlds" value="$(arg pkg_gazebo_worlds)" />
        <arg name="world_name" value="$(arg world_name)"/>
        <arg name="paused" value="$(arg paused)" />
        <arg name="use_sim_time" value="$(arg use_sim_time)" />
        <arg name="gui" value="$(arg gui)" />
    </include>-->

    <include ns="ls_left" file="$(find sick_safetyscanners)/launch/sick_safetyscanners.launch">
        <arg name="sensor_ip" value="141.3.80.119"/>
        <arg name="sensor_tcp_port" value="2122"/>
        <arg name="host_ip" value="$(optenv ROS_IP)"/>
    </include>

    <include ns="ls_right" file="$(find sick_safetyscanners)/launch/sick_safetyscanners.launch">
        <arg name="sensor_ip" value="141.3.80.118"/>
        <arg name="sensor_tcp_port" value="2122"/>
        <arg name="host_ip" value="$(optenv ROS_IP)"/>
    </include>

    <include file="$(find cob_bringup)/drivers/scan_unifier.launch" >
        <arg name="robot" value="$(arg robot)" />
        <arg name="input_scans" value="['/base_laser_front/scan','/base_laser_rear/scan']"/>
        <arg name="output_scan" value="/scan_unified"/>
    </include>

    <!-- run scan unifier -->
    <node pkg="cob_scan_unifier" type="scan_unifier_node" name="$(arg name)" output="log">
        <rosparam subst_value="True" param="input_scans">"['/base_laser_front/scan','/base_laser_rear/scan']"</rosparam>
        <remap from="scan_unified" to="/scan_unified"/>
    </node>

<!--     TODO: Do I need this?? -->
<!--	<node ns="$(arg name)" pkg="generic_throttle" type="generic_throttle_node.py" name="generic_throttle">
		<rosparam subst_value="True">{topics: [$(arg output_scan): {latched: False, lazy: True, topic_rate: 1.0}] }</rosparam>
	</node>
    range filter....
<node pkg="laser_filters" type="scan_to_scan_filter_chain" name="scan_unifier_filter">
		<rosparam command="load" file="$(arg pkg_hardware_config)/robots/$(arg robot)/config/scan_unifier_filter.yaml"/>
		<remap from="scan" to="$(arg output_scan)"/>
		<remap from="scan_filtered" to="$(arg output_scan)_filtered"/>
        </node>-->

<!-- TODO: Implement this functions -->
<!--    <include file="$(find cob_bringup)/tools/emergency_stop_monitor.launch" >
            <arg name="robot" value="$(arg robot)" />
    </include>
    <include file="$(find cob_bringup)/drivers/battery_voltage.launch" >
            <arg name="robot" value="$(arg robot)" />
    </include>
        <include file="$(find cob_bringup)/tools/battery_monitor.launch" >
            <arg name="robot" value="$(arg robot)" />
</include>-->

    <include file="$(find cob_bringup)/components/ros_control_base.launch">
        <arg name="robot" value="$(arg robot)"/>
        <arg name="pkg_hardware_config" value="$(arg pkg_config)"/>
        <arg name="driver_yaml" value="$(arg driver_yaml)"/>
        <arg name="controller_yaml" value="$(arg controller_yaml)"/>

        <arg name="can_device" value="can0"/>

        <arg name="sim" value="$(arg sim)"/>

        <arg name="velocity_smoother_config_file" value="$(arg pkg_config)/hardware/velocity_smoother.yaml"/>
        <arg name="twist_mux_config_locks" value="$(arg pkg_config)/hardware/twist_mux_locks.yaml"/>
        <arg name="twist_mux_config_topics" value="$(arg pkg_config)/hardware/twist_mux_topics.yaml"/>
    </include>

<!--    TODO: Add this later -->
<!-- start additional packages -->
