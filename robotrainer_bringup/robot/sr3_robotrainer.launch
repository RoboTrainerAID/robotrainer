          <arg name="unified_laser_scan" value="true"/>
    </include>
    <include if="$(arg navigation)" file="$(find cob_navigation_global)/launch/2dnav_ros_eband.launch">
  	  <arg name="robot" value="raw3-5"/>
	  <arg name="robot_env" value="$(arg robot_env)"/>
