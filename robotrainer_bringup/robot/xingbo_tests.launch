<?xml version="1.0"?>
<launch>

    <arg name="robot_env" default="$(optenv ROBOT_ENV ipr-robotrainer)"/>
    <arg name="sim" default="false"/>
    <arg name="fts_sim" default="false"/>
    
    <arg name="driver_yaml" default="$(find robotrainer_bringup)/configs/sr2_robotrainer_base_driver.yaml"/>
<!--     <arg name="controller_yaml" default="$(find robotrainer_bringup)/configs/robotrainer_base_controller_fast.yaml"/> -->
    <arg name="controller_yaml" default="$(find robotrainer_bringup)/configs/robotrainer_base_controller.yaml"/>
    <arg name="robotrainer_modalities_yaml" default="$(find robotrainer_bringup)/configs/modalities.yaml" />

    <include file="$(find robotrainer_bringup)/robot/sr2_robotrainer.launch" >
        <arg name="robot_env" value="$(arg robot_env)"/>
        <arg name="driver_yaml" value="$(arg driver_yaml)"/>
        <arg name="controller_yaml" value="$(arg controller_yaml)"/>
        <arg name="fts_sim" value="$(arg fts_sim)"/>
        <arg name="sim" value="$(arg sim)"/>
        <arg name="robotrainer_modalities_yaml" value="$(arg robotrainer_modalities_yaml)"/>
    </include>
    
<!--    <group ns="base">
        <node pkg="controller_manager" type="controller_manager" name="base_controller_loader" args="load fts_controller" respawn="false" output="screen"/>
    </group>-->

    <include ns="robotrainer" file="$(find ipr_helpers)/launch/extract_mobile_robot_base.launch" />
    
    <include file="$(find leg_tracker)/launch/leg_tracker_one_person.launch" />
    
    <include file="$(find robotrainer_deviation)/launch/robotrainer_deviation.launch" />

    <!--include file="$(find robotrainer_deviation)/launch/robotrainer_deviation.launch" >

    </include-->

</launch>
