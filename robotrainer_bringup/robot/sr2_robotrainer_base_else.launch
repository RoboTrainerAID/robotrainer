<?xml version="1.0"?>
<launch>

    <arg name="not_base" default="false"/>
    <arg name="not_all" default="false"/>

    <arg name="robot_env" default="$(optenv ROBOT_ENV ipr-robotrainer)"/>
    <arg name="sim" default="false"/>
    <arg name="fts_sim" default="false"/>
    
    <arg name="driver_yaml" default="$(find robotrainer_bringup)/configs/sr2_robotrainer_base_driver.yaml"/>
    <arg name="robotrainer_controller_yaml" default="$(find robotrainer_bringup)/configs/robotrainer_base_controller_fast.yaml"/>
    <arg name="robotrainer_modalities_yaml" default="$(find robotrainer_bringup)/configs/modalities.yaml" />

    <arg name="controllers_to_load" default="twist_controller"/>
    <arg name="robotrainer_controller" default="fts_controller"/>
    <arg name="base_controllers_to_spawn" default="joint_state_controller odometry_controller $(arg robotrainer_controller)"/>

    <group ns="base" unless="$(arg not_base)">
        <rosparam command="load" file="$(arg robotrainer_controller_yaml)"/>
    </group>

    <include file="$(find sr2_bringup)/robot/sr2_everyting_except_base.launch" unless="$(arg not_all)">
        <arg name="robot_env" value="$(arg robot_env)"/>
        <arg name="navigation" value="true"/>
        <arg name="driver_yaml" value="$(arg driver_yaml)"/>
<!--         <arg name="controller_yaml" value="$(arg controller_yaml)"/> -->
        <arg name="unload_default_controller" value="true"/>
        <arg name="fts" value="true"/>
        <arg name="fts_sim" value="$(arg fts_sim)"/>
        <arg name="sim" value="$(arg sim)"/>
        <arg name="base_controllers_to_spawn" value="$(arg base_controllers_to_spawn)"/>
    </include>

    <include file="$(find sr2_bringup)/robot/sr2_base_driver.launch" unless="$(arg not_base)">
        <arg name="robot_env" value="$(arg robot_env)"/>
        <arg name="navigation" value="true"/>
        <arg name="driver_yaml" value="$(arg driver_yaml)"/>
<!--         <arg name="controller_yaml" value="$(arg controller_yaml)"/> -->
        <arg name="unload_default_controller" value="true"/>
        <arg name="fts" value="true"/>
        <arg name="fts_sim" value="$(arg fts_sim)"/>
        <arg name="sim" value="$(arg sim)"/>
        <arg name="base_controllers_to_spawn" value="$(arg base_controllers_to_spawn)"/>
    </include>
    
    <group ns="base" unless="$(arg not_base)">
        <node pkg="controller_manager" type="controller_manager" name="base_controller_loader" args="load $(arg controllers_to_load)" respawn="false" output="screen"/>
    </group>
    

    <rosparam command="load" file="$(find robotrainer_bringup)/configs/modalities_chain.yaml" unless="$(arg not_base)"/>
    <rosparam command="load" file="$(arg robotrainer_modalities_yaml)" unless="$(arg not_base)"/>
    
</launch>
