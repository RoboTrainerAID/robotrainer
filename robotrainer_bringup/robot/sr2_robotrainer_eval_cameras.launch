<?xml version="1.0"?>
<launch>
               
        <include file="$(find openni2_launch)/launch/openni2.launch" >
                
                <arg name="camera" value="camera_legs" />
                <arg name="device_id" value="#1" />
        </include>
        
        <node name="robot_camera_transform" pkg="tf2_ros" type="static_transform_publisher" args="-0.375 0 0.75 3.14 1.1 0.0 base_link camera_legs_link" />
        <node name="camera_optical_transform" pkg="tf2_ros" type="static_transform_publisher" args="0 -0.02 0 0 0 0 1 camera_legs_link camera_legs_depth_frame" />
        <node name="camera_depth_optical_frame_transform" pkg="tf2_ros" type="static_transform_publisher" args="0 0 0 -0.5 0.5 -0.5 0.5 camera_legs_depth_frame camera_legs_depth_optical_frame" />
        
        
        <include file="$(find openni2_launch)/launch/openni2.launch" >
                
                <arg name="camera" value="camera_body" />
                <arg name="device_id" value="#2" />
        </include>
        
        <node name="robot_camera_body_transform" pkg="tf2_ros" type="static_transform_publisher" args="0.15 0 1.05 3.14 -0.3 0.0 base_link camera_body_link" />
        <node name="camera_body_optical_transform" pkg="tf2_ros" type="static_transform_publisher" args="0 -0.02 0 0 0 0 1 camera_body_link camera_body_depth_frame" />
        <node name="camera_body_depth_optical_frame_transform" pkg="tf2_ros" type="static_transform_publisher" args="0 0 0 -0.5 0.5 -0.5 0.5 camera_body_depth_frame camera_body_depth_optical_frame" />
        
        
 <!--        <node pkg="camera_lower_leg_tracking" name="feet_detection" type="feet_detection_node" output="screen">
                <param name="ground_level" value="0.005" />
                <param name="point_size_post_init" value="0.01" />
                <param name="point_size_pre_init" value="0.001" />
                <param name="min_cluster_size_post_init" value="200" />
                <param name="min_cluster_size_pre_init" value="2000" />
                <param name="cluster_tolerance" value="0.03" />
                <param name="icp_fitness_threshhold" value="0.0001" />
                <param name="init_frontal_capture_frame" value="50" />
                <param name="init_side_end_frame" value="80" />
                <param name="init_side_capture_frame" value="75" />
                <rosparam command="load" file="$(find camera_lower_leg_tracking)/include/KalmanFilterParameters.yaml"/>
        </node>
   -->     
        <include ns="robotrainer" file="$(find ipr_helpers)/launch/extract_mobile_robot_base.launch" />
</launch>


