<launch>

    <!-- Lower leg tracking with 3D camera -->
    <include file="$(find openni2_launch)/launch/openni2.launch" >
        <arg name="camera" value="lower_legs_camera"/>
        <arg name="device_id" value="1@0"/>
    </include>
        
